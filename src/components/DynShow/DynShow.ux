<import name="online-image" src="@components/BetterOnlineImage/BetterOnlineImage.ux"></import>

<template>
  <div class="comp-root">
    <div class="card-main" @click="GoDetail">
      <div class="user">
      <image class="userface" src="{{dyn.modules.module_author.face}}@65w_65h" alt="/common/fullgray.png"></image>
      <div class="userinfo">
        <text class="username"  style="margin-bottom: 3px">{{ dyn.modules.module_author.name }}</text>
        <text style="font-size: 18px; color: #5e5e5e" if="{{ dyn.modules.module_author.pub_time }}">
          {{ dyn.modules.module_author.pub_time }}
        </text>
        <text style="font-size: 18px; color: #5e5e5e">
          {{ pubAction }}
        </text>
      </div>
    </div>
    <!-- 纯文字动态：内容卡片必须渲染，否则刚发布的动态会看起来没有加载出来 -->
    <div class="content" if="{{dyn.type == 'DYNAMIC_TYPE_WORD'}}">
      <text class="dyn-title" if="{{dyn_title}}">{{ dyn_title }}</text>
      <text class="dyn-content-text">{{ dyn.modules.module_dynamic.desc.text }}</text>
    </div>
    <div class="content" if="{{dyn.type == 'DYNAMIC_TYPE_DRAW'}}">
      <text class="dyn-title" if="{{dyn_title}}">{{ dyn_title }}</text>
      <text class="dyn-content-text">{{ dyn.modules.module_dynamic.desc.text }}</text>
      <online-image class="dyn-content-draw-preview" width="180px" height="100px" margin-top="5px" lock-size="true"
        loading-anim="true" src="{{ dyn.modules.module_dynamic.major.draw.items[0].src }}@180w_100h"></online-image>
    </div>
    <!-- 视频投稿动态：展示封面与标题 -->
    <div class="content" if="{{dyn.type == 'DYNAMIC_TYPE_AV' || dyn.type == 'DYNAMIC_TYPE_UGC_SEASON'}}">
      <text class="dyn-content-text" if="{{dyn.modules.module_dynamic.desc.text}}">{{ dyn.modules.module_dynamic.desc.text }}</text>
      <online-image width="170px" height="96px" margin-top="5px" lock-size="true" loading-anim="true"
        if="{{media_cover}}" src="{{media_cover}}@170w_96h"></online-image>
      <text class="dyn-media-title" if="{{media_title}}">{{ media_title }}</text>
    </div>
    <!-- 专栏动态：展示封面与标题 -->
    <div class="content" if="{{dyn.type == 'DYNAMIC_TYPE_ARTICLE'}}">
      <text class="dyn-content-text" if="{{dyn.modules.module_dynamic.desc.text}}">{{ dyn.modules.module_dynamic.desc.text }}</text>
      <online-image width="170px" height="96px" margin-top="5px" lock-size="true" loading-anim="true"
        if="{{media_cover}}" src="{{media_cover}}@170w_96h"></online-image>
      <text class="dyn-media-title" if="{{media_title}}">{{ media_title }}</text>
    </div>
    <!-- 直播动态：只展示封面和标题，不跳转直播间 -->
    <div class="dyn-live-card" if="{{live_preview}}">
      <div class="dyn-live-head">
        <text class="dyn-live-badge">直播</text>
        <text class="dyn-live-status {{live_preview.isLive ? 'dyn-live-status-on' : ''}}">{{ live_preview.statusText }}</text>
      </div>
      <online-image width="170px" height="96px" margin-top="5px" lock-size="true" loading-anim="true"
        if="{{live_preview.cover}}" src="{{live_preview.cover}}@170w_96h"></online-image>
      <text class="dyn-live-title" if="{{live_preview.title}}">{{ live_preview.title }}</text>
      <text class="dyn-live-area" if="{{live_preview.areaName}}">{{ live_preview.areaName }}</text>
    </div>
    <!-- 投票动态：展示投票标题与参与人数，点击进入详情参与 -->
    <div class="dyn-vote-card" if="{{vote_preview}}">
      <div class="dyn-vote-head">
        <text class="dyn-vote-badge">投票</text>
        <text class="dyn-vote-join">{{ vote_join_text }}</text>
      </div>
      <text class="dyn-vote-title">{{ vote_preview.title }}</text>
    </div>
    </div>

    <div class="action-sep"></div>
    <div class="actions">
      <div class="dyn-action" @click="ToggleLike">
        <image class="dyn-action-icon"
          src="{{ liked ? '/common/reply_liked.png' : '/common/replycontrol_like.png' }}"></image>
        <text class="dyn-action-text {{ liked ? 'dyn-action-text-liked' : '' }}">{{ likeLabel }}</text>
      </div>
      <div class="dyn-action" @click="OpenComment">
        <image class="dyn-action-icon" src="/common/replycontrol_reply.png"></image>
        <text class="dyn-action-text">{{ commentLabel }}</text>
      </div>
      <div class="dyn-action" @click="OpenShare">
        <image class="dyn-action-icon dyn-action-icon-share" src="/common/dyn_share.png"></image>
        <text class="dyn-action-text">{{ forwardLabel }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { ExtractDynamicLive, ExtractDynamicVote } from "@src/dynamictools.ts"
export default {
  props: {
    dyn: {
      type: Object,
      default: {}
    }
  },
  data: {
    pubAction: "未知",
    media_cover: "",
    media_title: "",
    dyn_title: "",
    liked: false,
    likeCount: 0,
    commentCount: 0,
    forwardCount: 0,
    hasCommentCount: false,
    hasForwardCount: false,
    vote_preview: null,
    live_preview: null,
    likePending: false,
    sharePending: false
  },
  computed: {
    likeLabel() {
      if (this.likeCount > 0) return this.$app.$def.tools.formatNumber(this.likeCount)
      return this.liked ? "已赞" : "点赞"
    },
    commentLabel() {
      if (this.hasCommentCount) return this.$app.$def.tools.formatNumber(this.commentCount)
      return "评论"
    },
    forwardLabel() {
      if (this.hasForwardCount) return this.$app.$def.tools.formatNumber(this.forwardCount)
      return "转发"
    },
    vote_join_text() {
      const join = this.vote_preview ? Number(this.vote_preview.joinNum) || 0 : 0
      return join > 0 ? `${this.$app.$def.tools.formatNumber(join)}人参与` : "投票"
    }
  },
  RefreshActionState() {
    const modules = this.dyn && this.dyn.modules
    const stat = modules && modules.module_stat
    const like = stat && stat.like
    const comment = stat && stat.comment
    const forward = stat && stat.forward
    const status = like && like.status
    this.liked = status === true || status === 1 || status === "1" || status === "STATE_LIKE"
    this.likeCount = Number(like && like.count) || 0
    this.hasCommentCount = !!comment && comment.count !== undefined && comment.count !== null
    this.commentCount = Number(comment && comment.count) || 0
    this.hasForwardCount = !!forward && forward.count !== undefined && forward.count !== null
    this.forwardCount = Number(forward && forward.count) || 0
  },
  GetDynId() {
    if (!this.dyn) return ""
    let id = this.dyn.id_str || this.dyn.id || this.dyn.dyn_id_str || this.dyn.dynamic_id_str || ""
    if (!id && this.dyn.basic) {
      const type = Number(this.dyn.basic.comment_type)
      if (type === 11 || type === 17) {
        id = this.dyn.basic.comment_id_str || ""
      }
    }
    return String(id || "")
  },
  GetCommentTarget() {
    const basic = this.dyn && this.dyn.basic
    const rawType = basic && basic.comment_type
    if (rawType !== undefined && rawType !== null && Number(rawType) === 0) {
      return null
    }
    const type = Number(rawType) || 17
    const oid = (basic && basic.comment_id_str) || this.GetDynId()
    if (!oid) return null
    return { type: String(type), oid: String(oid) }
  },
  GetShareTitle() {
    const modules = this.dyn && this.dyn.modules
    const md = modules && modules.module_dynamic
    let text = this.dyn_title || this.media_title || (md && md.desc && md.desc.text) || ""
    text = String(text).replace(/\s+/g, " ").trim()
    if (!text) {
      text = (modules && modules.module_author && modules.module_author.name
        ? modules.module_author.name + "的"
        : "") + "动态"
    }
    return Array.from(text).slice(0, 36).join("")
  },
  async ToggleLike() {
    if (this.likePending) return
    const dynId = this.GetDynId()
    if (!dynId) {
      prompt.showToast({message: "暂时无法点赞这条动态"})
      return
    }
    const nextLiked = !this.liked
    this.likePending = true
    try {
      const result = await global.biliclient.thumbDynamic(dynId, nextLiked ? 1 : 2)
      if (result && Number(result.code) === 0) {
        this.liked = nextLiked
        this.likeCount = Math.max(0, this.likeCount + (nextLiked ? 1 : -1))
        prompt.showToast({message: nextLiked ? "点赞成功" : "已取消赞"})
      } else {
        prompt.showToast({
          message: result && result.message ? `点赞失败：${result.message}` : "点赞失败，请重试",
          duration: 3000
        })
      }
    } catch (e) {
      global.logger.error("动态点赞失败: ", e)
      prompt.showToast({message: "点赞失败，请重试", duration: 3000})
    } finally {
      this.likePending = false
    }
  },
  OpenComment() {
    const target = this.GetCommentTarget()
    if (!target) {
      prompt.showToast({message: "该动态未开放评论"})
      return
    }
    const author = this.dyn.modules && this.dyn.modules.module_author
    router.push({
      uri: "pages/reply/replys",
      params: {
        type: target.type,
        oid: target.oid,
        replycount: this.commentCount,
        upmid: author && author.mid ? String(author.mid) : ""
      }
    })
  },
  OpenShare() {
    const dynId = this.GetDynId()
    if (!dynId) {
      prompt.showToast({message: "暂时无法分享这条动态"})
      return
    }
    prompt.showDialog({
      title: "分享动态",
      message: this.GetShareTitle(),
      buttons: [
        { text: "分享到动态" },
        { text: "分享给好友" },
        { text: "取消" }
      ],
      success: (data) => {
        if (!data) return
        if (data.index === 0) this.ShareToDynamic()
        else if (data.index === 1) this.ShareToFriends()
      }
    })
  },
  ShareToFriends() {
    const dynId = this.GetDynId()
    if (!dynId) return
    router.push({
      uri: "pages/message/dmlist",
      params: {
        shareBvid: "",
        shareDynId: dynId,
        shareDynTitle: this.GetShareTitle(),
        shareDynUrl: `https://t.bilibili.com/${dynId}`
      }
    })
  },
  async ShareToDynamic() {
    if (this.sharePending) return
    const dynId = this.GetDynId()
    if (!dynId) {
      prompt.showToast({message: "暂时无法分享这条动态"})
      return
    }
    this.sharePending = true
    prompt.showToast({message: "正在分享…"})
    try {
      const result = await global.biliclient.createDynamicRepost(dynId, "")
      const data = (result && result.data) || {}
      const rejected = data.result != null && Number(data.result) !== 0
      if (result && Number(result.code) === 0 && !rejected) {
        const newId = data.dyn_id_str || data.dyn_id || ""
        if (newId) global.publishedDynamicResult = { id: String(newId) }
        prompt.showToast({message: "已分享到动态", duration: 3000})
      } else {
        prompt.showToast({
          message: (data.message || (result && result.message))
            ? `分享失败：${data.message || result.message}`
            : "分享失败，请重试",
          duration: 3000
        })
      }
    } catch (e) {
      global.logger.error("分享动态失败: ", e)
      prompt.showToast({message: "分享失败，请重试", duration: 3000})
    } finally {
      this.sharePending = false
    }
  },
  // 视频投稿 / 专栏动态的封面与标题（兼容旧版 article 与新版 opus 两种结构）
  BuildMediaInfo() {
    const modules = this.dyn && this.dyn.modules
    const md = modules && modules.module_dynamic
    const major = md && md.major
    const type = this.dyn.type

    // 带标题的纯文字/图文动态，标题可能不在 major 里
    if (type == "DYNAMIC_TYPE_WORD" || type == "DYNAMIC_TYPE_DRAW") {
      this.dyn_title = (md && md.title) || (major && major.opus && major.opus.title) || ""
    }
    if (!major) {
      return
    }

    let cover = ""
    let title = ""

    if (type == "DYNAMIC_TYPE_AV" || type == "DYNAMIC_TYPE_UGC_SEASON") {
      const archive = major.archive || major.ugc_season
      if (archive) {
        cover = archive.cover || ""
        title = archive.title || ""
      }
    } else if (type == "DYNAMIC_TYPE_ARTICLE") {
      if (major.article) {
        const covers = major.article.covers || []
        cover = covers[0] || ""
        title = major.article.title || ""
      } else if (major.opus) {
        const pics = major.opus.pics || []
        cover = (pics[0] && (pics[0].url || pics[0].src)) || ""
        title = major.opus.title || ""
      }
    }

    if (cover.indexOf("//") === 0) {
      cover = "https:" + cover
    }
    this.media_cover = cover
    this.media_title = title
  },
  generatePubAction() {
    if (this.dyn.modules.module_author.pub_action) return this.dyn.modules.module_author.pub_action

    switch (this.dyn.type) {
      case "DYNAMIC_TYPE_NONE":
        return "<无效动态>"
      case "DYNAMIC_TYPE_FORWARD":
        return "转发了动态"
      case "DYNAMIC_TYPE_AV":
        return "投稿了视频"
      case "DYNAMIC_TYPE_PGC":
        return "发布了剧集"
      case "DYNAMIC_TYPE_COURSES":
        return "发布了课程动态"
      case "DYNAMIC_TYPE_WORD":
        return "发布了文本动态"
      case "DYNAMIC_TYPE_DRAW":
        return "发布了图文动态"
      case "DYNAMIC_TYPE_ARTICLE":
        return "投稿了专栏"
      case "DYNAMIC_TYPE_MUSIC":
        return "投稿了音频"
      case "DYNAMIC_TYPE_COMMON_SQUARE":
        return "分享了内容"
      case "DYNAMIC_TYPE_COMMON_VERTICAL":
        return "发布了竖屏动态"
      case "DYNAMIC_TYPE_LIVE":
        return "分享了直播间"
      case "DYNAMIC_TYPE_MEDIALIST":
        return "分享了收藏夹"
      case "DYNAMIC_TYPE_COURSES_SEASON":
        return "发布了课程内容"
      case "DYNAMIC_TYPE_COURSES_BATCH":
        return "<批量课程动态>"
      case "DYNAMIC_TYPE_AD":
        return "<广告动态>"
      case "DYNAMIC_TYPE_APPLET":
        return "<小程序动态>"
      case "DYNAMIC_TYPE_SUBSCRIPTION":
        return "<订阅动态>"
      case "DYNAMIC_TYPE_LIVE_RCMD":
        return "分享了直播开播"
      case "DYNAMIC_TYPE_BANNER":
        return "发布了横幅动态"
      case "DYNAMIC_TYPE_UGC_SEASON":
        return "更新了合集内容"
      case "DYNAMIC_TYPE_SUBSCRIPTION_NEW":
        return "<新订阅动态>"
      default:
        return "<未知动态类型>"
    }
  },
  GoDetail() {
    router.push({
      uri: "pages/app/features/dynamic/detail",
      params: {
        dyn: this.dyn,
        dynId: this.GetDynId(),
        pubAction: this.generatePubAction()
      }
    })
  },
  onInit(){
    this.pubAction = this.generatePubAction()
    this.BuildMediaInfo()
    this.RefreshActionState()
    this.vote_preview = ExtractDynamicVote(this.dyn)
    this.live_preview = ExtractDynamicLive(this.dyn)
    this.$watch("dyn", "RefreshActionState")
    this.$watch("dyn", "RefreshExtraInfo")
  },
  RefreshExtraInfo() {
    this.vote_preview = ExtractDynamicVote(this.dyn)
    this.live_preview = ExtractDynamicLive(this.dyn)
    this.BuildMediaInfo()
  }
}
</script>

<style lang="less">
@import "@less/global.less";

.comp-root {
  flex-direction: column;
  background-color: #262626af;
  border-radius: 25px;
  width: 190px;
  padding: 10px;
  margin-top: 10px;
}

.card-main {
  width: 100%;
  flex-direction: column;
}

.action-sep {
  width: 100%;
  height: 1px;
  background-color: #3a3a3a;
  margin-top: 8px;
}

.actions {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
}

.dyn-action {
  flex: 1;
  height: 30px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.dyn-action-icon {
  width: 18px;
  height: 18px;
  object-fit: scale-down;
}

.dyn-action-icon-share {
  width: 18px;
  height: 18px;
}

.dyn-action-text {
  margin-left: 2px;
  font-size: 14px;
  font-weight: 600;
  color: #9e9e9e;
}

.dyn-action-text-liked {
  color: #ff7da8;
}

.user {
  align-items: center;
  flex-direction: row;
}

.userinfo {
  margin-left: 10px;
  flex-direction: column;
}

.userface {
  border-radius: 50%;
  min-width: 65px;
  min-height: 65px;
  max-width: 65px;
  max-height: 65px;
}

.username {
  font-size: 22px;
  font-weight: 600;
  lines: 1;
  text-overflow: ellipsis;
}

.content {
  flex-direction: column;
}

.dyn-title {
  font-size: 22px;
  font-weight: 600;
  max-width: 100%;
  margin-bottom: 4px;
  lines: 2;
  text-overflow: ellipsis;
}

.dyn-content-text {
  font-size: 20px;
  font-weight: 600;
  max-width: 100%;
  max-height: 100px;
  text-overflow: ellipsis;
}

.dyn-media-title {
  margin-top: 5px;
  font-size: 20px;
  font-weight: 600;
  max-height: 56px;
  lines: 2;
  text-overflow: ellipsis;
}

// 投票预览卡片
.dyn-vote-card {
  width: 100%;
  margin-top: 6px;
  padding: 8px;
  border-radius: 16px;
  background-color: #34343b;
  flex-direction: column;
}

.dyn-vote-head {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.dyn-vote-badge {
  height: 24px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 12px;
  background-color: #262626;
  font-size: 14px;
  font-weight: 600;
  color: #ff7da8;
  text-align: center;
}

.dyn-vote-join {
  font-size: 14px;
  font-weight: 600;
  color: #9e9e9e;
}

.dyn-vote-title {
  margin-top: 5px;
  font-size: 18px;
  font-weight: 600;
  max-height: 50px;
  lines: 2;
  text-overflow: ellipsis;
}

// 直播动态预览
.dyn-live-card {
  width: 100%;
  margin-top: 6px;
  padding: 8px;
  border-radius: 16px;
  background-color: #34343b;
  flex-direction: column;
}

.dyn-live-head {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.dyn-live-badge {
  height: 24px;
  padding-left: 8px;
  padding-right: 8px;
  border-radius: 12px;
  background-color: #262626;
  font-size: 14px;
  font-weight: 600;
  color: #ff7da8;
  text-align: center;
}

.dyn-live-status {
  font-size: 14px;
  font-weight: 600;
  color: #9e9e9e;
}

.dyn-live-status-on {
  color: #ff7da8;
}

.dyn-live-title {
  margin-top: 5px;
  font-size: 18px;
  font-weight: 600;
  max-height: 50px;
  lines: 2;
  text-overflow: ellipsis;
}

.dyn-live-area {
  margin-top: 2px;
  font-size: 14px;
  font-weight: 500;
  color: #888888;
  lines: 1;
  text-overflow: ellipsis;
}
</style>