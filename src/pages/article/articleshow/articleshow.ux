<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="html-renderer" src="@components/HtmlRenderer/HtmlRenderer.ux"></import>

<template>
  <div class="page card-enter {{scrclass}}">
    <title-bar title="专栏阅读" right-text="{{ offline ? '' : 'article.more' }}"
      @right-click="OpenMoreMenu"></title-bar>
    <image class="loading-spin" style="position: absolute; margin-top: 245px" if="{{anims.show_loading}}" src="{{anims.loading_src.value}}"></image>
    <div if="{{showarticle}}" class="articlebox">
      <div class="infobox">
        <text class="title">{{ article.readInfo.title }}</text>
        <div class="infofield" static>
          <image src="/common/article_up.png" static></image>
          <text class="infofield_text">{{ article.readInfo.author.name }}</text>
        </div>
        <div class="infofield" static>
          <image src="/common/article_clock.png" static></image>
          <text class="infofield_text" static>预计阅读用时</text>
          <text class="pinknum" style="margin-left: 5px">
            {{ readingTime }}
          </text>
          <text class="infofield_text" style="margin-left: 5px" static>分钟</text>
        </div>
      </div>
      <div style="margin-top: 22px; width: 80%; justify-content: center">
        <html-renderer doms="{{article_content}}"></html-renderer>
      </div>
    </div>
    <div class="article-error" if="{{loadFailed}}" @click="RetryLoad">
      <text class="article-error-text">专栏加载失败，点击重试</text>
    </div>
    <text style="margin-top: 50px"></text>

    <div class="more-overlay {{moreClosing ? 'modal-closing' : 'modal-entering'}}" if="{{moreMounted}}">
      <div class="more-card {{moreClosing ? '' : 'modal-panel-entering'}}">
        <text class="more-title">专栏操作</text>
        <div class="more-item" @click="CacheArticle">
          <text class="more-item-text more-item-danger">{{ caching ? "缓存中…" : "缓存此专栏" }}</text>
        </div>
        <div class="more-item" @click="CloseMoreMenu">
          <text class="more-item-text">取消</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
export default {
  public: {
    cvid: "cv1",
    offline: false,
    // 仅在离线模式（直读本地html）时需要传入该参数
    article_html: ""
  },
  private: {
    scrclass: "",
    article: {},
    article_content: {},
    showarticle: false,
    loadFailed: false,

    current_page_num: 0,
    max_page_num: 0,
    caching: false,
    moreMounted: false,
    moreClosing: false,
    moreAnimTimer: 0,
    anims: {
      show_loading: false
    }
  },
  computed: {
    readingTime(){
      return this.$app.$def.articletools.estimateReadingTime(this.article.readInfo.content)
    }
  },
  SplitArticle(arr, split_count) {
    let result = [];
    for (let i = 0; i < arr.length; i += split_count) {
        result.push(arr.slice(i, i + split_count));
    }
    return result;
  },
  async LoadArticle() {
    this.loadFailed = false
    this.anims.show_loading = true
    this.anims.loading.start()

    // 预留加载delay以避免页面切换的卡顿
    setTimeout(async() => {
      try{
        let article_html = ""
        if(this.offline){
          article_html = this.article_html
        }
        else{
          // 解析器依赖旧版专栏页的 __INITIAL_STATE__，不能使用默认的新 opus 页面
          article_html = await global.biliclient.getArticle(this.cvid, false)
          if (!article_html) throw new Error("empty article html")
        }

        const article = this.$app.$def.articletools.parseArticlePageHtml(article_html)
        this.article.readInfo = article.readInfo // 原地更新 减少开辟内存空间

        let article_full = this.$app.$def.htmlparser.parseContentHtml(article.readInfo.content, false)
        this.$app.$def.articletools.PatchArticleContent(article_full)

        //this.article_content = this.SplitArticle(article_full, global.settings.SETTINGS.article_split_dom_count)
        this.article_content = article_full
        this.max_page_num = this.article_content.length

        global.logger.log(article.readInfo.content)
        global.logger.log(JSON.stringify(this.article_content))

        this.anims.loading.stop()
        this.anims.show_loading = false
        global.runGC()
        this.showarticle = true
      }
      catch(e){
        global.logger.error(e.toString())
        this.loadFailed = true
        try { this.anims.loading.stop() } catch (err) {}
        this.anims.show_loading = false
      }
    }, 1000)
  },
  RetryLoad() {
    this.loadFailed = false
    this.showarticle = false
    this.LoadArticle()
  },
  OpenMoreMenu() {
    if (this.offline) return
    clearTimeout(this.moreAnimTimer)
    this.moreClosing = false
    this.moreMounted = true
  },
  CloseMoreMenu() {
    clearTimeout(this.moreAnimTimer)
    if (!this.moreMounted) return
    this.moreClosing = true
    this.moreAnimTimer = setTimeout(() => {
      this.moreMounted = false
      this.moreClosing = false
    }, 180)
  },
  async CacheArticle() {
    if (this.caching || this.offline || !this.cvid) return
    this.caching = true
    try {
      const html = await global.biliclient.getArticle(this.cvid, false)
      const title = (this.article.readInfo && this.article.readInfo.title) || this.cvid
      const id = await global.savedcontent.SavedContentManager.storeContent(title, html, "article")
      if (id) {
        prompt.showToast({message: "专栏已缓存"})
      } else {
        prompt.showToast({message: "缓存失败，请重试", duration: 3000})
      }
    } catch (e) {
      global.logger.error("缓存专栏失败: ", e)
      prompt.showToast({message: "缓存失败，请重试", duration: 3000})
    } finally {
      this.caching = false
      this.CloseMoreMenu()
    }
  },
  onInit() {
    // 路由参数可能被序列化为字符串，统一归一化，避免把 "false" 当作缓存模式
    this.offline = this.offline === true || this.offline === "true"
    global.animengine.defaults.loading.CreateLoadingAnimation(this)
    this.LoadArticle()
  },
  onReady() {
    this.$options.onBackPress = () => {
      if (this.moreMounted) {
        this.CloseMoreMenu()
        return true
      }
      global.ui.OnBackPressTriggered()
      return true
    }
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './articleshow.less';
</style>