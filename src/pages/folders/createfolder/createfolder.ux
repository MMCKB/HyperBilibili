<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll {{scrclass}}" bounces="true">
      <title-bar title="新建收藏夹" back-disabled="{{ creating ? '1' : '' }}"></title-bar>
      <div class="create-form">
        <div class="form-card" @click="OpenNameInput">
          <div class="form-head">
            <text class="form-label">名称</text>
            <text class="form-count">{{ nameCount }}/20</text>
          </div>
          <text class="form-value {{ folderName ? '' : 'form-placeholder' }}">
            {{ folderName || "点击填写（必填）" }}
          </text>
        </div>

        <div class="form-card" @click="OpenIntroInput">
          <div class="form-head">
            <text class="form-label">简介</text>
            <text class="form-count">{{ introCount }}/200</text>
          </div>
          <text class="form-value {{ folderIntro ? '' : 'form-placeholder' }}">
            {{ folderIntro || "点击填写（可不填）" }}
          </text>
        </div>

        <div class="form-card public-card" @click="TogglePublic">
          <text class="form-label">公开</text>
          <div class="switch {{ isPublic ? 'switch-on' : '' }}">
            <div class="switch-knob {{ isPublic ? 'switch-knob-on' : '' }}"></div>
          </div>
        </div>

        <div class="submit-button {{ creating ? 'submit-button-disabled' : '' }}" @click="CreateFolder">
          <text class="submit-text {{ creating ? 'submit-text-disabled' : '' }}">{{ creating ? "创建中" : "完成" }}</text>
        </div>
      </div>
      <text class="bottom-space"></text>
    </scroll>
    <full-screen-input style="position: absolute" if="{{ inputField === 'name' }}"
      initial-value="{{ folderName }}" maxlength="20" @send="FinishNameInput" @exit="ExitInput"></full-screen-input>
    <full-screen-input style="position: absolute" if="{{ inputField === 'intro' }}"
      initial-value="{{ folderIntro }}" maxlength="200" @send="FinishIntroInput" @exit="ExitInput"></full-screen-input>
  </div>
</template>

<script>
import prompt from "@system.prompt"

export default {
  public: {
    bvid: ""
  },
  private: {
    scrclass: "",
    folderName: "",
    folderIntro: "",
    isPublic: true,
    inputField: "",
    creating: false
  },
  computed: {
    nameCount() {
      return Array.from(this.folderName).length
    },
    introCount() {
      return Array.from(this.folderIntro).length
    }
  },
  OpenNameInput() {
    if (!this.creating) this.inputField = "name"
  },
  OpenIntroInput() {
    if (!this.creating) this.inputField = "intro"
  },
  FinishNameInput(evt) {
    this.inputField = ""
    this.folderName = evt.detail.content
  },
  FinishIntroInput(evt) {
    this.inputField = ""
    this.folderIntro = evt.detail.content
  },
  ExitInput() {
    this.inputField = ""
  },
  TogglePublic() {
    if (!this.creating) this.isPublic = !this.isPublic
  },
  async CreateFolder() {
    if (this.creating) return
    const title = this.folderName.trim()
    if (!title) {
      prompt.showToast({message: "名称不能为空"})
      return
    }
    if (Array.from(title).length > 20) {
      prompt.showToast({message: "名称最多 20 个字"})
      return
    }

    this.creating = true
    try {
      const result = await global.biliclient.createFavouriteFolder(
        title,
        this.folderIntro.trim(),
        this.isPublic
      )
      const created = result && result.data
      const folderId = created ? (created.id || created.media_id) : 0
      if (!result || result.code !== 0 || !folderId) {
        this.creating = false
        prompt.showToast({
          message: result && result.message
            ? `创建失败：${result.message}`
            : "创建失败，请重试",
          duration: 3000
        })
        return
      }
      global.createdFavFolderResult = {
        bvid: this.bvid,
        folder: {
          id: folderId,
          title: created.title || title
        }
      }
      // 保持 creating=true 直到页面退出，避免返回动画期间重复提交
      global.ui.OnBackPressTriggered()
    } catch (e) {
      this.creating = false
      global.logger.error("创建收藏夹失败: ", e)
      prompt.showToast({message: "创建失败，请重试", duration: 3000})
    }
  }
}
</script>

<style lang="less">
@import "@less/global.less";

.create-form {
  width: 370px;
  flex-direction: column;
  margin-top: 10px;
}

.form-card {
  width: 100%;
  height: 90px;
  border-radius: 30px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
  padding-left: 24px;
  padding-right: 24px;
  margin-bottom: 8px;
}

.form-head {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  color: #ffffff;
  font-size: 30px;
  font-weight: 600;
  line-height: 32px;
}

.form-count {
  color: #9e9e9e;
  font-size: 26px;
  font-weight: 400;
  line-height: 30px;
}

.form-value {
  width: 100%;
  margin-top: 2px;
  color: #ff7da8;
  font-size: 30px;
  font-weight: 600;
  line-height: 34px;
  lines: 1;
  text-overflow: ellipsis;
}

.form-placeholder {
  color: #9e9e9e;
  font-weight: 400;
}

.public-card {
  height: 76px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.switch {
  position: relative;
  flex: none;
  width: 64px;
  height: 38px;
  border-radius: 19px;
  background-color: #3a3a3a;
}

.switch-on {
  background-color: #ff7da8;
}

.switch-knob {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #ffffff;
}

.switch-knob-on {
  left: 29px;
}

.submit-button {
  width: 100%;
  height: 80px;
  border-radius: 90px;
  background-color: #ff7da8;
  align-items: center;
  justify-content: center;
}

.submit-button-disabled {
  background-color: #262626;
}

.submit-text {
  color: #ffffff;
  font-size: 40px;
  font-weight: 600;
}

.submit-text-disabled {
  color: #5f5f5f;
}

.bottom-space {
  height: 8px;
  width: 100%;
}
</style>
