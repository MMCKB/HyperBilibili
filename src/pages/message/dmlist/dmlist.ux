<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll {{scrclass}}" bounces="true">
      <title-bar title="{{ shareBvid ? '分享给好友' : 'dmlist.title' }}" back-disabled="{{ sendingShare ? '1' : '' }}"></title-bar>
      
      <image style="position: absolute; margin-top: 245px" if="{{anims.show_loading}}" src="{{anims.loading_src.value}}">
      </image>
      
      <div class="dmlist" for="{{sessions}}" if="{{!shareBvid && show_dmlist}}">
        <div class="user" onclick="GoDMPage($item.talker_id)" onlongpress="LongPressHandle($item.talker_id)">
          <image class="userface" src="{{session_cards[$item.talker_id].face}}@75w_75h" alt="/common/fullgray.png"></image>
          <div class="infoarea">
            <text class="username">{{ session_cards[$item.talker_id].name }}</text>
            <text class="lastmsg">
              {{
              JSON.parse($item.last_msg.content).content ||
              JSON.parse($item.last_msg.content).reply_content ||
              JSON.parse($item.last_msg.content).text ||
              $t("dmlist.currentNoMessage")
              }}
            </text>
          </div>
          <image if="{{$item.pinned}}" src.static="/common/dmlist_pinned_mask.png" style.static="position: absolute; top: 0px; right: 0px"></image>
        </div>
      </div>
      
      <text style.static="font-size: 18px; margin-top: 15px; font-weight: 600" show="{{!shareBvid && Show20UserLimit}}">
        {{ $t("dmlist.userCountLimit") }}
      </text>

      <div class="friend-grid" if="{{shareBvid && friendsLoaded && !shareEmpty}}">
        <div class="friend-col">
          <div class="friend-cell {{$item.selected ? 'friend-cell-selected' : ''}}" for="{{friendCol1}}" @click="ToggleFriend($item.uid)">
            <image class="friend-avatar" src="{{$item.face}}" alt="/common/fullgray.png"></image>
            <text class="friend-name">{{$item.name}}</text>
            <text class="friend-check" if="{{$item.selected}}">✓</text>
          </div>
        </div>
        <div class="friend-col">
          <div class="friend-cell {{$item.selected ? 'friend-cell-selected' : ''}}" for="{{friendCol2}}" @click="ToggleFriend($item.uid)">
            <image class="friend-avatar" src="{{$item.face}}" alt="/common/fullgray.png"></image>
            <text class="friend-name">{{$item.name}}</text>
            <text class="friend-check" if="{{$item.selected}}">✓</text>
          </div>
        </div>
      </div>

      <text class="friend-empty" if="{{shareBvid && friendsLoaded && shareEmpty}}" @click="RetryLoad">{{ friendsLoadFailed ? '加载好友失败，点击重试' : '暂无可分享的好友' }}</text>
      <text class="share-bottom-space" if="{{shareBvid}}"></text>

      <text style="margin-top: 25px" static></text>
    </scroll>
    <div class="share-footer" if="{{shareBvid}}">
      <div class="share-confirm {{ shareConfirmEnabled ? 'share-confirm-on' : '' }}" @click="ConfirmShare">
        <text class="share-confirm-text {{ shareConfirmEnabled ? 'share-confirm-text-on' : '' }}">{{ shareConfirmLabel }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

export default {
  public: {
    shareBvid: "",
    shareTitle: "",
    shareMessage: ""
  },
  private: {
    sessions: [],
    session_cards: {},
    show_dmlist: false,
    Show20UserLimit: false,
    sharing: false,
    friendsLoaded: false,
    friendsLoadFailed: false,
    shareFriends: [],
    friendCol1: [],
    friendCol2: [],
    shareEmpty: true,
    selectedCount: 0,
    sendingShare: false,
    shareSendDone: 0,
    shareSendTotal: 0,
    anims: {
      show_loading: false
    },
    scrclass: ""
  },
  computed: {
    shareConfirmEnabled() {
      return this.friendsLoaded && this.selectedCount > 0
    },
    shareConfirmLabel() {
      if (!this.friendsLoaded) {
        return "加载中…"
      }
      if (this.sendingShare) {
        return `发送中 ${this.shareSendDone}/${this.shareSendTotal}…`
      }
      return this.selectedCount > 0 ? `确定（${this.selectedCount}）` : "确定"
    }
  },
  async LongPressHandle(id) {
    if (this.shareBvid) return
    if (global.settings.SETTINGS.pinnedDMUsers.includes(id)) {
      const saved = await global.settings.saveSettings({
        pinnedDMUsers: global.settings.SETTINGS.pinnedDMUsers.filter((item) => item !== id)
      })
      prompt.showToast({
        message: saved ? "已取消固定" : "操作保存失败，请重试"
      })
    } else {
      var pinnedDMUsers = global.settings.SETTINGS.pinnedDMUsers
      pinnedDMUsers.push(id)
      const saved = await global.settings.saveSettings({
        pinnedDMUsers
      })
      prompt.showToast({
        message: saved ? "成功固定该用户" : "操作保存失败，请重试"
      })
    }
    this.InitSessions()
  },
  async InitSessions() {
    this.friendsLoaded = false
    this.friendsLoadFailed = false
    this.shareEmpty = true
    this.selectedCount = 0
    try {
      this.anims.loading.start()
      this.anims.show_loading = true

      const dmData = await global.biliclient.getDMSessions(1, 2)
      if (!dmData || !Array.isArray(dmData.session_list)) {
        throw new Error("getDMSessions returned no session_list")
      }
      let sessionsData = dmData.session_list.slice(0, this.shareBvid ? 20 : 10)

      let session_uids = []
      let filteredSessions = []

      sessionsData.forEach(session => {
        if (session.talker_id) {
          if (global.settings.SETTINGS.pinnedDMUsers.indexOf(session.talker_id) === -1) {
            filteredSessions.push(session)
            session_uids.push(session.talker_id)
          } else {
            global.logger.log("[InitSessions] 重复UID已剔除：", session.talker_id)
          }
        } else {
          global.logger.log("[InitSessions] 非法UID已剔除：", session.talker_id)
        }
      })

      const pinnedObjects = global.settings.SETTINGS.pinnedDMUsers.map(uid => {
        return { talker_id: uid, pinned: true }
      })
      const combinedSessions = pinnedObjects.concat(filteredSessions)
      session_uids = session_uids.concat(global.settings.SETTINGS.pinnedDMUsers)

      this.sessions.splice(0, this.sessions.length, ...combinedSessions)

      let cards = {}
      if (session_uids.length) {
        try {
          cards = (await global.biliclient.getMultiUserInfoByUID(session_uids)) || {}
        } catch (cardErr) {
          global.logger.error("[InitSessions] 获取用户卡片失败：", cardErr)
          if (!this.shareBvid) {
            throw cardErr
          }
        }
      }
      this.session_cards = cards

      if (this.shareBvid) {
        this.BuildFriends(global.settings.SETTINGS.pinnedDMUsers, filteredSessions, cards)
        this.friendsLoaded = true
      }

      this.Show20UserLimit = true
      this.show_dmlist = true
    } catch (e) {
      global.logger.error(e.toString())
      if (this.shareBvid) {
        this.friendsLoaded = true
        this.friendsLoadFailed = true
        this.shareEmpty = true
      }
    } finally {
      try {
        if (this.anims && this.anims.loading) {
          this.anims.loading.stop()
        }
      } catch (err) {}
      if (this.anims) {
        this.anims.show_loading = false
      }
    }
  },
  BuildFriends(pinnedUids, sessions, cards) {
    const seen = {}
    const list = []
    const add = (rawUid) => {
      const uid = String(rawUid === null || rawUid === undefined ? "" : rawUid)
      if (!uid || uid === "0" || uid === "undefined" || uid === "null" || seen[uid]) {
        return
      }
      seen[uid] = true
      const card = (cards && cards[uid]) || {}
      let face = card.face || ""
      if (face.indexOf("http:") === 0) {
        face = "https:" + face.slice(5)
      }
      if (face && face.indexOf("@") < 0) {
        face += "@96w_96h"
      }
      if (!face) {
        face = "/common/fullgray.png"
      }
      list.push({
        uid,
        name: card.name || ("用户" + uid),
        face,
        selected: false
      })
    }

    const pinnedList = pinnedUids || []
    pinnedList.forEach(uid => add(uid))
    const sessionList = sessions || []
    sessionList.forEach(session => add(session.talker_id))

    this.shareFriends = list
    this.shareEmpty = list.length === 0
    this.selectedCount = 0
    this.SplitFriends()
  },
  SplitFriends() {
    const col1 = []
    const col2 = []
    this.shareFriends.forEach((friend, index) => {
      if (index % 2 === 0) {
        col1.push(friend)
      } else {
        col2.push(friend)
      }
    })
    this.friendCol1 = col1
    this.friendCol2 = col2
  },
  ToggleFriend(rawUid) {
    if (this.sendingShare || !this.friendsLoaded) {
      return
    }
    const uid = String(rawUid || "")
    if (!uid) {
      return
    }
    this.shareFriends = this.shareFriends.map(friend => {
      if (friend.uid === uid) {
        return Object.assign({}, friend, { selected: !friend.selected })
      }
      return friend
    })
    this.SplitFriends()
    this.selectedCount = this.shareFriends.filter(friend => friend.selected).length
  },
  RetryLoad() {
    if (this.sendingShare) {
      return
    }
    this.friendsLoaded = false
    this.friendsLoadFailed = false
    this.shareEmpty = true
    this.shareFriends = []
    this.friendCol1 = []
    this.friendCol2 = []
    this.selectedCount = 0
    this.InitSessions()
  },
  Delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms))
  },
  IsStopSendError(result) {
    if (!result) {
      return false
    }
    const code = Number(result.code)
    const message = String(result.message || "")
    return code === -352 || code === -412 || message.indexOf("频繁") >= 0 ||
      message.indexOf("风控") >= 0 || message.indexOf("稍后再试") >= 0
  },
  async ConfirmShare() {
    if (this.sendingShare || !this.shareBvid || !this.friendsLoaded) {
      return
    }
    const targets = this.shareFriends.filter(friend => friend.selected)
    if (targets.length === 0) {
      prompt.showToast({ message: "请先选择好友" })
      return
    }

    this.sendingShare = true
    this.shareSendDone = 0
    this.shareSendTotal = targets.length

    const message = String(this.shareMessage || "").trim()
    const text = `${message ? message + "\n" : ""}分享视频：${this.shareTitle || this.shareBvid}\nhttps://www.bilibili.com/video/${this.shareBvid}`
    const succeeded = {}
    let ok = 0
    let attempted = 0
    let lastError = ""

    for (let i = 0; i < targets.length; i++) {
      let result = null
      try {
        result = await global.biliclient.SendDMSessionMessage(targets[i].uid, 1, text)
      } catch (e) {
        global.logger.error("分享给好友失败: ", targets[i].uid, e)
        result = null
      }
      attempted++
      this.shareSendDone = i + 1

      if (result && Number(result.code) === 0) {
        ok++
        succeeded[targets[i].uid] = true
      } else {
        lastError = result ? `${result.code} ${result.message || ""}`.trim() : "网络异常"
        if (this.IsStopSendError(result)) {
          break
        }
      }

      if (i < targets.length - 1) {
        await this.Delay(350)
      }
    }

    if (ok === targets.length) {
      prompt.showToast({ message: `已分享给 ${ok} 位好友` })
      setTimeout(() => {
        if (global.ui && global.ui.OnBackPressTriggered) {
          global.ui.OnBackPressTriggered()
        } else {
          router.back()
        }
      }, 500)
      return
    }

    this.shareFriends = this.shareFriends.map(friend => {
      if (succeeded[friend.uid]) {
        return Object.assign({}, friend, { selected: false })
      }
      return friend
    })
    this.SplitFriends()
    this.selectedCount = this.shareFriends.filter(friend => friend.selected).length
    this.sendingShare = false

    const failed = attempted - ok
    const unsent = targets.length - attempted
    let resultMessage = ""
    if (ok > 0) {
      resultMessage = `已分享 ${ok} 位`
      if (failed > 0) {
        resultMessage += `，${failed} 位失败`
      }
      if (unsent > 0) {
        resultMessage += `，${unsent} 位未发送`
      }
    } else {
      resultMessage = lastError || "分享失败，请重试"
    }
    prompt.showToast({ message: resultMessage, duration: 3000 })
  },
  GoDMPage(targetId) {
    if (this.shareBvid) {
      this.ShareToFriend(targetId)
      return
    }
    router.push({
      uri: "pages/message/dmpage",
      params: {
        myId: global.biliclient.accountInfo.mid,
        targetId: targetId,
        myPic: global.biliclient.accountInfo.face,
        targetPic: this.session_cards[`${targetId}`].face
      }
    })
  },
  async ShareToFriend(targetId) {
    if (this.sharing || !this.shareBvid || !targetId) return
    this.sharing = true
    const card = this.session_cards[`${targetId}`] || {}
    const message = String(this.shareMessage || "").trim()
    const videoUrl = `https://www.bilibili.com/video/${this.shareBvid}`
    const text = `${message ? message + "\n" : ""}分享视频：${this.shareTitle || this.shareBvid}\n${videoUrl}`
    try {
      const result = await global.biliclient.SendDMSessionMessage(targetId, 1, text)
      if (result && result.code === 0) {
        prompt.showToast({message: `已分享给 ${card.name || "好友"}`})
        setTimeout(() => {
          router.back()
        }, 500)
      } else {
        prompt.showToast({
          message: result
            ? `分享失败，错误代码：${result.code} 原因：${result.message}`
            : "分享失败，请重试",
          duration: 3000
        })
      }
    } catch (e) {
      global.logger.error("分享给好友失败: ", e)
      prompt.showToast({message: "分享失败，请重试", duration: 3000})
    } finally {
      this.sharing = false
    }
  },
  onInit() {
    global.animengine.defaults.loading.CreateLoadingAnimation(this)
    this.InitSessions()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./dmlist.less";
</style>