<import name="switch-bar" src="@components/SwitchBar/SwitchBar.ux"></import>
<import name="videoshow" src="@components/Video/Video.ux"></import>

<template>
  <div class="page">
    <image style="position: absolute; left: 0px" src="{{getBgImg}}"></image>
    <scroll scroll-y="true" id="mainscroll" class="scroll {{scrclass}}" bounces="true">
      <switch-bar title="main.title"></switch-bar>
      <!-- 首页标签页：推荐 / 热门 / 分区 -->
      <div class="typebar">
        <div class="typetab" @click="SwitchTab(0)">
          <text class="typetext" style="color: {{typebar_colors.c1}};">{{ $t("main.recommend") }}</text>
        </div>
        <div class="typetab" @click="SwitchTab(1)">
          <text class="typetext" style="color: {{typebar_colors.c2}};">{{ $t("main.popular") }}</text>
        </div>
        <div class="typetab" @click="SwitchTab(2)">
          <text class="typetext" style="color: {{typebar_colors.c3}};">{{ $t("main.region") }}</text>
        </div>
      </div>
      <text class="tip">{{ funnytip }}</text>
      <image class="loading-spin"
        style="position: absolute; margin-top: 265px"
        if="{{anims.show_loading}}"
        src="{{anims.loading_src.value}}">
      </image>

      <!-- 推荐 -->
      <div class="recommend_div" if="{{current_tab == 0 && show_recommend_div}}">
        <videoshow for="{{recommend_vids}}" video="{{$item}}" tid="vids"></videoshow>
        <text style="margin-top: 25px" static></text>
      </div>

      <!-- 热门 -->
      <div class="recommend_div" if="{{current_tab == 1 && show_popular_div}}">
        <videoshow for="{{popular_vids}}" video="{{$item}}"></videoshow>
        <text style="margin-top: 25px" static></text>
      </div>

      <!-- 分区入口 -->
      <div class="zone_area" if="{{current_tab == 2 && !zone_selected}}">
        <div class="zone_grid">
          <div class="zone_col">
            <div class="zone_cell" for="{{zone_col1}}" @click="OpenZone($item.rid, $item.name)">
              <text class="zone_name">{{ $item.name }}</text>
            </div>
          </div>
          <div class="zone_col">
            <div class="zone_cell" for="{{zone_col2}}" @click="OpenZone($item.rid, $item.name)">
              <text class="zone_name">{{ $item.name }}</text>
            </div>
          </div>
        </div>
        <text style="margin-top: 25px" static></text>
      </div>

      <!-- 分区排行榜 -->
      <div class="recommend_div" if="{{current_tab == 2 && zone_selected}}">
        <div class="zone_header" @click="BackToZones">
          <div class="zone_header_back">
            <image src="/common/changepage_left.png" static
              style="width: 32px; height: 32px; object-fit: scale-down"></image>
            <text class="zone_header_back_text">{{ $t("main.region") }}</text>
          </div>
          <text class="zone_header_name">{{ zone_name }}</text>
        </div>
        <videoshow if="{{show_zone_div}}" for="{{zone_vids}}" video="{{$item}}"></videoshow>
        <text style="margin-top: 25px" static></text>
      </div>
    </scroll>
    <div style="position: absolute; bottom: 0px" @click="Refresh()" if="{{current_tab != 2 || zone_selected}}">
      <image src="/common/main_floatingrefresh.png" static></image>
    </div>
    <text style="position: absolute; color: rgba(0, 0, 0, 0); width: 0px; top: 50px">
      {{ anims.refresh_bottom.value }}
    </text>
    <image
      if="{{anims.showRefreshFX}}"
      style="position: absolute; bottom: {{anims.refresh_bottom.value}}px"
      src.static="/common/TranslateFX/refreshFX.png">
    </image>
  </div>
</template>

<script>
import prompt from "@system.prompt"

export default {
  private: {
    scrclass: "",
    current_tab: 0,
    typebar_colors: {
      c1: "#0851ac",
      c2: "#919191",
      c3: "#919191"
    },
    // 初始化推荐视频数组为空，后续采用原地更新方式
    recommend_vids: [],
    show_recommend_div: false,
    popular_vids: [],
    show_popular_div: false,
    popular_loaded: false,
    popular_pn: 1,
    zone_selected: false,
    zone_rid: -1,
    zone_name: "",
    zone_vids: [],
    show_zone_div: false,
    zone_col1: [],
    zone_col2: [],
    funnytip: "",
    anims: {
      show_loading: false,
      refresh: null,
      showRefreshFX: false,
      refresh_bottom: { value: "-350" }
    },
    bgimg: ""
  },
  computed: {
    getBgImg() {
      return this.$app.$def.bgimg.GetBackgroundImageSrc();
    }
  },
  // 分区排行榜入口（rid 与 B 站排行榜分区一致，0 为全站）
  BuildZoneGrid() {
    const zones = [
      { rid: 0, labelKey: "main.zones.all", fallback: "全站" },
      { rid: 1005, labelKey: "main.zones.douga", fallback: "动画" },
      { rid: 1003, labelKey: "main.zones.music", fallback: "音乐" },
      { rid: 1004, labelKey: "main.zones.dance", fallback: "舞蹈" },
      { rid: 1008, labelKey: "main.zones.game", fallback: "游戏" },
      { rid: 1010, labelKey: "main.zones.knowledge", fallback: "知识" },
      { rid: 1012, labelKey: "main.zones.tech", fallback: "科技" },
      { rid: 1018, labelKey: "main.zones.sports", fallback: "运动" },
      { rid: 1013, labelKey: "main.zones.car", fallback: "汽车" },
      { rid: 1020, labelKey: "main.zones.food", fallback: "美食" },
      { rid: 1024, labelKey: "main.zones.animal", fallback: "动物" },
      { rid: 1007, labelKey: "main.zones.kichiku", fallback: "鬼畜" },
      { rid: 1014, labelKey: "main.zones.fashion", fallback: "时尚" },
      { rid: 1002, labelKey: "main.zones.ent", fallback: "娱乐" },
      { rid: 1001, labelKey: "main.zones.cinephile", fallback: "影视" }
    ]

    const col1 = []
    const col2 = []
    zones.forEach((zone, index) => {
      const name = typeof this.$t === "function" ? this.$t(zone.labelKey) : zone.fallback
      const item = { rid: zone.rid, name: name }
      if (index % 2 == 0) {
        col1.push(item)
      } else {
        col2.push(item)
      }
    })
    this.zone_col1 = col1
    this.zone_col2 = col2
  },
  SwitchTab(index) {
    if (this.anims.showRefreshFX || this.current_tab == index) {
      return
    }
    this.current_tab = index
    this.typebar_colors = {
      c1: index == 0 ? "#0851ac" : "#919191",
      c2: index == 1 ? "#0851ac" : "#919191",
      c3: index == 2 ? "#0851ac" : "#919191"
    }
    if (index == 1 && !this.popular_loaded) {
      this.GetPopularVideos(true)
    }
    this.ResetScrollTop()
  },
  ResetScrollTop() {
    if (!this.$nextTick || !this.$element) {
      return
    }
    this.$nextTick(() => {
      const scroller = this.$element("mainscroll")
      if (scroller && scroller.scrollTo) {
        scroller.scrollTo({ top: 0 })
      }
    })
  },
  OpenZone(rid, name) {
    if (this.anims.showRefreshFX || this.anims.show_loading) {
      return
    }
    this.zone_selected = true
    this.zone_rid = rid
    this.zone_name = name
    this.LoadZoneVideos(rid)
    this.ResetScrollTop()
  },
  BackToZones() {
    if (this.anims.showRefreshFX) {
      return
    }
    this.zone_selected = false
    this.zone_vids.splice(0, this.zone_vids.length)
    this.show_zone_div = false
    this.ResetScrollTop()
  },
  async GetPopularVideos(reset) {
    if (reset) {
      this.popular_pn = 1
    }
    this.anims.show_loading = true
    this.anims.loading.start()
    this.show_popular_div = false

    try {
      const { home_vid_count } = global.settings.SETTINGS
      const result = await global.biliclient.getPopularVideos(this.popular_pn, home_vid_count)
      this.popular_pn = result.no_more ? 1 : this.popular_pn + 1
      this.popular_vids.splice(0, this.popular_vids.length, ...result.list)
      this.popular_loaded = true
    } catch (error) {
      global.logger.error("获取热门视频时出错:", error)
      prompt.showToast({ message: "获取热门视频失败，请重试。" })
    } finally {
      this.anims.loading.stop()
      this.anims.show_loading = false
      this.show_popular_div = true
    }
  },
  async LoadZoneVideos(rid) {
    this.anims.show_loading = true
    this.anims.loading.start()
    this.show_zone_div = false

    try {
      const { home_vid_count } = global.settings.SETTINGS
      const vids = await global.biliclient.getRankVideosByRid(rid)
      const limited = vids.slice(0, home_vid_count)
      this.zone_vids.splice(0, this.zone_vids.length, ...limited)
    } catch (error) {
      global.logger.error("获取分区视频时出错:", error)
      prompt.showToast({ message: "获取分区视频失败，请重试。" })
    } finally {
      this.anims.loading.stop()
      this.anims.show_loading = false
      this.show_zone_div = true
    }
  },
  async ReloadCurrentTab() {
    if (this.current_tab == 0) {
      await this.GetVids()
    } else if (this.current_tab == 1) {
      await this.GetPopularVideos(false)
    } else if (this.current_tab == 2 && this.zone_selected) {
      await this.LoadZoneVideos(this.zone_rid)
    }
  },
  async Refresh() {
    if (this.anims.showRefreshFX) {
      prompt.showToast({ message: "你先别急。" });
      return
    }
    this.anims.show_loading = true
    this.anims.showRefreshFX = true
    this.anims.loading.start()

    // 只隐藏当前标签页的列表，避免刷新后其它标签页变成空白
    if (this.current_tab == 0) {
      this.show_recommend_div = false
    } else if (this.current_tab == 1) {
      this.show_popular_div = false
    } else if (this.zone_selected) {
      this.show_zone_div = false
    }

    this._timerRefreshStart = setTimeout(() => {
      this.anims.refresh.start();
    }, 200);

    this._timerRefreshStop = setTimeout(async () => {
      this.anims.refresh_bottom.value = "-350px";
      this.anims.refresh.stop();
      this.anims.showRefreshFX = false;
      await this.ReloadCurrentTab();
    }, 1200);
  },
  async GetVids() {
    try {
      const { fresh_type, home_vid_count } = global.settings.SETTINGS;

      const vids = await global.biliclient.getMainPageRecommendVideos(fresh_type, home_vid_count);
      this.recommend_vids.splice(0, this.recommend_vids.length, ...vids);
    } catch (error) {
      global.logger.error("获取推荐视频时出错:", error);
      prompt.showToast({ message: "获取推荐视频失败，请重试。" });
    } finally {
      this.anims.loading.stop();
      this.anims.show_loading = false;
      this.show_recommend_div = true;
    }
  },
  async checkUpdates() {
    try {
      const result = await global.biliclient.checkHyperbilibiliUpdates();
      if (result.update) {
        prompt.showToast({ message: result.msg, duration: 6000 });
      }
    } catch (error) {
      global.logger.error("检查更新时出错:", error);
    }
  },
  onInit() {
    this.BuildZoneGrid()
    this.GetVids();
    this.funnytip = this.$app.$def.funnytips.getTips();
    this.checkUpdates();
  },
  onReady() {
    const { refresh_bottom } = this.anims;

    global.animengine.defaults.loading.CreateLoadingAnimation(this);
    this.anims.loading.start();

    // 分区详情属于页内二级视图：返回键先回分区入口，而不是直接退出页面
    this.$options.onBackPress = () => {
      if (this.zone_selected) {
        this.BackToZones()
        return true
      }
      global.ui.OnBackPressTriggered()
      return true
    }

    this.anims.refresh = new global.animengine.DomAnim(
      "mainPage",
      { value: "0px" },
      refresh_bottom,
      0,
      450,
      1000
    );
  },
  onDestroy() {
    global.animengine.clearPageAnims("mainPage");
    if (this._timerRefreshStart) {
      clearTimeout(this._timerRefreshStart);
      this._timerRefreshStart = null;
    }
    if (this._timerRefreshStop) {
      clearTimeout(this._timerRefreshStop);
      this._timerRefreshStop = null;
    }
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './main.less';
</style>