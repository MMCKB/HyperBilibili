<import name="html-renderer" src="@components/HtmlRenderer/HtmlRenderer.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <image style="position: absolute; margin-top: 300px" if="{{anims.show_loading}}" src="{{anims.loading_src.value}}"></image>
    <text style="font-weight: 600; margin-top: 45px; font-size: 40px">{{ $t("eularead.title") }}</text>
    <text style="font-weight: 600; margin-top: 15px; font-size: 24px; width: 75%">{{ $t("eularead.sectitle") }}</text>
    <div if="{{show_content}}" style="margin-top: 20px; width: 75%; flex-direction: column; align-items: center">
      <html-renderer doms="{{content}}"></html-renderer>
      <default-button margin-top="25px" primary="true" text="同意并继续" @click="Agree"></default-button>
      <default-button margin-top="15px" text="退出" @click="Exit"></default-button>
    </div>
    <text style="margin-top: 25px"></text>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
export default {
  private: {
    show_content: false,
    content: [],
    saving: false,
    anims: {
      show_loading: false
    }
  },
  async LoadEula(){
    this.anims.show_loading = true
    this.anims.loading.start()

    // 预留init时间
    this._loadEulaTimer = setTimeout(async() => {
      try {
        // 冷启动时 app.onCreate 可能还没执行完，等 BilibiliClient 就绪
        let waited = 0
        while (!global.biliclient && waited < 10000) {
          await new Promise((resolve) => setTimeout(resolve, 300))
          waited += 300
        }
        if (!global.biliclient) {
          throw new Error("biliclient not ready")
        }
        var html = await global.biliclient.getEulaShowContent()
        this.content = this.$app.$def.htmlparser.parseContentHtml(html)
      } catch (e) {
        global.logger.error("加载协议内容失败:", e)
        this.content = []
      } finally {
        // 内容加载失败也必须显示按钮，否则用户无法同意/退出，只能重启
        this.show_content = true
        this.anims.show_loading = false
        this.anims.loading.stop()
      }
    }, 1500);
  },
  async Agree(){
    if (this.saving) return
    this.saving = true

    // 等写入磁盘成功后再跳转，避免“内存里已同意、磁盘上仍是 false”导致下次启动又回协议页
    const saved = await global.settings.saveSettings({
      agreedAllAgreements: true
    })
    this.saving = false

    if (!saved) {
      prompt.showToast({ message: "协议状态保存失败，请重试", duration: 3000 })
      return
    }

    router.clear()
    router.replace({
      uri: "pages/app/entry/splash"
    })
  },
  Exit(){
    router.clear()
    router.back()
  },
  onInit(){
    global.animengine.defaults.loading.CreateLoadingAnimation(this)
    this.LoadEula()
  },
  onDestroy(){
    if (this._loadEulaTimer) {
      clearTimeout(this._loadEulaTimer)
      this._loadEulaTimer = null
    }
    global.animengine.clearPageAnims(this.$page.name)
  }
}
</script>

<style lang="less">
@import '@less/global.less';
</style>