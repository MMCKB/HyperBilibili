<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll {{scrclass}}" bounces="true">
      <title-bar title="手机上看"></title-bar>
      <div class="phone-watch">
        <div class="qr-box">
          <qrcode value="{{videoUrl}}" show="{{showQr}}" style="width: 218px; height: 218px"></qrcode>
        </div>
        <text class="video-title">{{ title || "视频" }}</text>
        <text class="scan-tip">用手机扫一扫，打开视频</text>
      </div>
      <text style="margin-top: 20px"></text>
    </scroll>
  </div>
</template>

<script>
export default {
  public: {
    bvid: "",
    title: ""
  },
  private: {
    scrclass: "",
    videoUrl: "",
    showQr: false
  },
  onInit() {
    this.videoUrl = "https://www.bilibili.com/video/" + this.bvid
  },
  onReady() {
    this.showQr = true
  }
}
</script>

